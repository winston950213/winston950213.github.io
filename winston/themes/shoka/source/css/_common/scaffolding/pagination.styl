.pagination {
  width: 100%;
  margin: 1.5rem 0 2rem;
  color: var(--grey-5);

  .inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  .prev,
  .next {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    color: #fff;
    font-size: $font-size-larger;
    background-image: linear-gradient(to right, var(--color-pink) 0, var(--color-orange) 100%);
    box-shadow: 0 .25rem 1rem var(--box-bg-shadow);
    the-transition();

    &:hover {
      transform: translateY(-.125rem);
    }

    &.disabled {
      color: var(--grey-5);
      background-image: none;
      background-color: var(--grey-3);
      box-shadow: none;
    }
  }

  .page-info {
    min-width: 4rem;
    text-align: center;
    font-size: $font-size-small;

    small {
      margin: 0 .25rem;
      color: var(--grey-4);
    }
  }
}
