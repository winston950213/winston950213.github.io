.widgets {
  ul {
    counter-reset: none;
  }

  .item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .375rem;
    padding: .625rem 0;
    border-bottom: .0625rem dashed var(--grey-4);
    position: relative;

    &:first-child {
      padding-top: 0;
    }

    &:last-child {
      padding-bottom: 0;
      border-bottom: none;
    }

    .title {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      color: var(--text-color);
      font-size: $font-size-small;
      font-weight: 600;
      line-height: 1.5;
      border-bottom: none;
      the-transition();

      &:hover {
        color: var(--primary-color);
      }
    }

    .ic {
      margin-right: .25rem;
    }
  }
}
