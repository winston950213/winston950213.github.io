{% macro render(item) %}
{%- if item.link %}
  {%- set postTitleIcon = '<i class="ic i-link-alt"></i>' %}
{%- endif %}
{%- set postText = item.title or item.link or __('post.untitled') %}
<article class="item">
  <a class="card-image" href="{{ url_for(item.link or item.path) }}" itemprop="url" title="{{ postText }}">
    <img data-src="{{ _cover(item) }}" alt="{{ postText }}">
    <span class="card-title">{{ postTitleIcon | safe }}{{ postText }}</span>
  </a>
  <div class="card-content">
    <div class="summary">
      {%- if item.description %}
        {{ item.description }}
      {%- elif item.excerpt %}
        {{ item.excerpt | striptags(true) | escape | truncate(120) }}
      {%- else %}
        {{ item.content | striptags(true) | escape | truncate(120) }}
      {%- endif %}
    </div>
    <div class="publish-info">
      <span class="publish-date">
        <i class="ic i-calendar"></i><time datetime="{{ moment(item.date).format() }}">{{ date(item.date) }}</time>
      </span>
      {%- if item.categories.length > 0 %}
      {%- set lastcat = item.categories.last() %}
      <span class="publish-category">
        <i class="ic i-flag"></i><a href="{{ url_for(lastcat.path) }}" title="{{ lastcat.name }}">{{ lastcat.name }}</a>
      </span>
      {%- endif %}
    </div>
  </div>
  {%- if item.tags.length > 0 %}
  <div class="card-action">
    {%- for tag in item.tags.toArray() %}
    {%- if loop.index <= 4 %}
    <a class="chip" href="{{ url_for(tag.path) }}" title="{{ tag.name }}">{{ tag.name }}</a>
    {%- endif %}
    {%- endfor %}
  </div>
  {%- endif %}
</article>
{% endmacro %}
